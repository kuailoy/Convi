# OpenAI API key used by the Finnish sentence generator and Pattern Drill prototype.
# OPENAI_API_KEY=

# Required to authorize calls to the billable topic example generation endpoint.
# Keep this on the server; do not put it in the Expo app.
# GENERATOR_API_KEY=

# Azure Database for PostgreSQL
DB_HOST=your-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=convi_dev
DB_USER=your-microsoft-entra-user@example.com
DB_AUTH_MODE=entra
# Set this only when DB_AUTH_MODE=password.
# DB_PASSWORD=
